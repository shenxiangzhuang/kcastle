#!/usr/bin/env bash
# Sourced by ../check in its isolated run directory.
for case in stale:CurrentOnly unbounded-cache:BoundedCache evict-live:CachedReady parallel:BoundedWorker none:NoReady; do
    fault=${case%:*}
    invariant=${case#*:}
    name="probe-$fault"
    cat > "$name.cfg" <<CFG
CONSTANT Fault = "$fault"
SPECIFICATION Spec
INVARIANT $invariant
CFG
    result=0
    run_tlc "$name" > "$name.log" 2>&1 || result=$?
    if [[ $result -ne 12 ]] || ! grep -Fq "Invariant $invariant is violated." "$name.log"; then
        cat "$name.log"
        echo "FAIL: expected $invariant counterexample for $fault" >&2
        exit 1
    fi
    echo "PASS: $fault produces $invariant counterexample"
done

cat > probe-flash.cfg <<CFG
CONSTANT Fault = "flash"
SPECIFICATION Spec
PROPERTY NoIntermediateDowngrade
CFG
result=0
run_tlc probe-flash > probe-flash.log 2>&1 || result=$?
if [[ $result -ne 13 ]] || ! grep -Fq 'Action property NoIntermediateDowngrade is violated.' probe-flash.log; then
    cat probe-flash.log
    echo 'FAIL: expected NoIntermediateDowngrade counterexample for flash' >&2
    exit 1
fi
echo 'PASS: flash produces NoIntermediateDowngrade counterexample'
